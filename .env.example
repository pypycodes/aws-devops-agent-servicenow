# AWS DevOps Agent Demo — Environment Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# AWS profile (from ~/.aws/credentials or ~/.aws/config)
AWS_PROFILE=default

# Deployment environment name
ENV=dev

# AWS region
AWS_REGION=us-east-1

# DevOps Agent webhook credentials (from agent space event channel).
# Required when ENABLE_SERVICENOW is false. Unused when ServiceNow is enabled.
WEBHOOK_URL=
WEBHOOK_SECRET=

# Optional ServiceNow capability. When true, the ServiceNow incident Lambda is
# deployed and the webhook Lambda is omitted. When false, only the webhook
# Lambda is deployed and it triggers DevOps Agent directly.
ENABLE_SERVICENOW=false
SERVICENOW_INSTANCE_URL=
SERVICENOW_CLIENT_NAME=
SERVICENOW_CLIENT_ID=
SERVICENOW_CLIENT_SECRET=
SERVICENOW_INSTANCE_ID=

# Optional DevOps Agent lifecycle notifications 
NOTIFICATION_EMAIL=
